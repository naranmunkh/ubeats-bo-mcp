# ===========================================================================
# UBEats Backoffice (office.ubeats.mn) — Keycloak SSO auth
# ===========================================================================
# The BO login: same account, same values and same names as ubcab-bo-mcp.
# The UBEats BO is a client ("ubeats-bo") of the same Keycloak realm, so the BO
# account works here too. Copy these three from the bo-mcp project.
UBCAB_BO_USERNAME=naranmunkh@ubcab.mn
UBCAB_BO_PASSWORD=replace-me
# Keycloak 2FA (2026-10-05): base32 secret from the authenticator setup
# («Unable to scan?»). Without it every login fails with invalid_grant.
UBCAB_BO_TOTP_SECRET=

# Fallback login, used ONLY when UBCAB_BO_USERNAME/PASSWORD are not set.
# UBEATS_BO_USERNAME=
# UBEATS_BO_PASSWORD=
# UBEATS_BO_TOTP_SECRET=

# Optional refresh-token grant. Must be issued to the "ubeats-bo" client (a BO
# refresh token from ubcab-bo-mcp will not work). Expires; the password grant
# above is the durable option.
UBEATS_BO_REFRESH_TOKEN=

# ===========================================================================
# OIDC / base URLs (defaults match production; override only if they change)
# Verified 2026-08-18 from a live office.ubeats.mn session:
#   iss = https://sso.ubcabtech.com/realms/ubcab-bo   azp = ubeats-bo
# ===========================================================================
UBEATS_BO_CLIENT_ID=ubeats-bo
UBEATS_BO_SSO_URL=https://sso.ubcabtech.com
UBEATS_BO_REALM=ubcab-bo
UBEATS_BO_API_URL=https://ubeats-bo-api.ubcabtech.com
# Sent as Origin/Referer to satisfy the BO allowed-origins check.
UBEATS_BO_ORIGIN=https://office.ubeats.mn

# ===========================================================================
# Remote (Vercel) deployment only
# Secret bearer token clients must send to reach the /mcp endpoint.
# Generate one with:  openssl rand -hex 32
# REQUIRED in production — the endpoint fails closed without it.
# ===========================================================================
UBEATS_BO_MCP_AUTH_TOKEN=
