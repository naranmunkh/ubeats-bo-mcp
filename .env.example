# ===========================================================================
# UBEats Backoffice (office.ubeats.mn) — Keycloak SSO auth
# ===========================================================================
# SERVICE ACCOUNT — used only by stdio mode and the break-glass bearer.
# Connector users sign in with their own BO account instead (see below).
#
# (1) Offline token for the "ubeats-bo" client, from:  npm run login
UBEATS_BO_REFRESH_TOKEN=

# (2) The BO login — same account, values and names as ubcab-bo-mcp.
# Keycloak 2FA (2026-10-05): base32 secret from the authenticator setup
# («Unable to scan?»). Without it every password grant fails with invalid_grant.
UBCAB_BO_USERNAME=naranmunkh@ubcab.mn
UBCAB_BO_PASSWORD=
UBCAB_BO_TOTP_SECRET=

# (3) Fallback login, used ONLY when UBCAB_BO_USERNAME/PASSWORD are not set.
# UBEATS_BO_USERNAME=
# UBEATS_BO_PASSWORD=
# UBEATS_BO_TOTP_SECRET=

# ===========================================================================
# OIDC / base URLs (defaults match production; override only if they change)
# Verified 2026-08-18 from a live office.ubeats.mn session:
#   iss = https://sso.ubcabtech.com/realms/ubcab-bo   azp = ubeats-bo
# ===========================================================================
UBEATS_BO_CLIENT_ID=ubeats-bo
UBEATS_BO_SSO_URL=https://sso.ubcabtech.com
UBEATS_BO_REALM=ubcab-bo
UBEATS_BO_API_URL=https://ubeats-bo-api.ubcabtech.com
# Sent as Origin/Referer to satisfy the BO allowed-origins check.
UBEATS_BO_ORIGIN=https://office.ubeats.mn

# ===========================================================================
# Remote (Vercel) — each user connects with their OWN BO login
# ===========================================================================
# REQUIRED. Seals OAuth codes/tokens (AES-256-GCM) and doubles as a break-glass
# bearer that uses the service account above.  Generate:  openssl rand -hex 32
# Rotating it signs every connected user out.
UBEATS_BO_MCP_AUTH_TOKEN=

# REQUIRED. Who may connect: full emails, "@ubcab.mn" (whole domain) or "*"
# (any BO user). Empty = nobody (fails closed). Checked on every request.
UBEATS_BO_ALLOWED_EMAILS=naranmunkh@ubcab.mn
